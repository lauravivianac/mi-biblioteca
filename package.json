{
  "name": "mi-biblioteca",
  "version": "2.0.0",
  "description": "Plan lector y tracker de libros",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "npm run test:contrast && npm run test:planner && npm run test:booklookup && npm run test:ean && npm run test:shelves && npm run test:quotes && npm run test:suggest && npm run test:reviews && npm run test:taste && npm run test:gaps && npm run test:duel && npm run test:streak && npm run test:year && npm run test:username && npm run test:cards && npm run test:profile && npm run test:follows && npm run test:qr && npm run test:feed && npm run test:moderation && npm run test:alsoread && npm run test:swap && npm run test:worker",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:planner": "node scripts/test-planner.mjs",
    "test:booklookup": "node scripts/test-booklookup.mjs",
    "serve": "python3 -m http.server 8080",
    "test:worker": "node scripts/test-worker.mjs",
    "test:ean": "node scripts/test-ean.mjs",
    "test:shelves": "node scripts/test-shelves.mjs",
    "test:quotes": "node scripts/test-quotes.mjs",
    "test:suggest": "node scripts/test-suggest.mjs",
    "test:reviews": "node scripts/test-reviews.mjs",
    "test:taste": "node scripts/test-taste.mjs",
    "test:gaps": "node scripts/test-gaps.mjs",
    "test:duel": "node scripts/test-duel.mjs",
    "test:streak": "node scripts/test-streak.mjs",
    "test:year": "node scripts/test-year.mjs",
    "test:username": "node scripts/test-username.mjs",
    "test:cards": "node scripts/test-cards.mjs",
    "test:profile": "node scripts/test-profile.mjs",
    "test:follows": "node scripts/test-follows.mjs",
    "test:qr": "node scripts/test-qr.mjs",
    "test:feed": "node scripts/test-feed.mjs",
    "test:moderation": "node scripts/test-moderation.mjs",
    "test:alsoread": "node scripts/test-alsoread.mjs",
    "test:swap": "node scripts/test-swap.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-biblioteca \"node scripts/test-rules.mjs\"",
    "test:circuito": "firebase emulators:exec --only firestore,auth --project demo-biblioteca \"node --import ./scripts/emulador/registrar.mjs scripts/test-circuito.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1"
  }
}
