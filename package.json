    "test:explore": "node scripts/test-explore.mjs",
    "test:chat": "node scripts/test-chat.mjs",
    "test:posts": "node scripts/test-posts.mjs",
    "legal": "node scripts/build-legal.mjs",
    "test:push": "node scripts/test-push.mjs",
    "test:legal": "node scripts/test-legal.mjs",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project demo-biblioteca \"node scripts/test-e2e.mjs\"",
    "capturas": "firebase emulators:exec --only firestore,auth --project demo-biblioteca \"node scripts/capturas.mjs\"",
    "test:clases": "node scripts/test-clases.mjs",
