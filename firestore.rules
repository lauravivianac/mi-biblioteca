rules_version = '2';

/* ─────────────────────────────────────────────────────────────
   REGLAS DE SEGURIDAD  ·  historia #18

   PARA DESPLEGARLAS, desde la raíz del repositorio:
     npx firebase-tools deploy --only firestore:rules,firestore:indexes

   Los índices van en el mismo comando: el feed mezcla un filtro por un
   campo con un orden por otro, y eso necesita un índice declarado a
   mano en firestore.indexes.json o la consulta falla en producción.

   Mientras no se desplieguen, la base queda como esté ahora.
   ───────────────────────────────────────────────────────────── */

service cloud.firestore {
  match /databases/{database}/documents {

    /* Mirar si una cuenta es privada cuesta una lectura, y solo se
       paga al crear una flecha de seguimiento — no en cada consulta.

       EL `get('privada', false)` NO ES UN DETALLE. Estaba escrito
       `.data.privada == true`, y en el motor de reglas leer un campo
       que no está en el documento no da «falso»: da un ERROR de
       evaluación, y una regla que revienta DENIEGA.

       Consecuencia: cualquier perfil publicado sin ese campo —los de
       antes de que la cuenta privada existiera, o cualquier escritura
       parcial— era IMPOSIBLE DE SEGUIR. No fallaba a veces: no se podía
       seguir a esa persona nunca, y el error que llegaba al cliente era
       un «permiso denegado» sin más explicación.

       Comprobado contra el emulador de Firestore, no de memoria:
       perfil sin el campo → denegado; con `privada:false` → permitido.
       Con el valor por defecto, los dos funcionan. */
    function esPrivada(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId))
        && get(/databases/$(database)/documents/profiles/$(userId)).data.get('privada', false) == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /* BORRAR LO QUE NO EXISTE TIENE QUE PODERSE, Y ESTO NO ES UN
       DESCUIDO.

       En el motor de reglas, borrar un documento que no está deja
       `resource` a null, y leer `resource.data.loQueSea` sobre null no
       da «falso»: revienta la evaluación, y una regla que revienta
       deniega.

       Eso rompía BLOQUEAR, que es justo lo que nunca puede fallar.
       `block()` borra en un mismo lote el bloqueo, las dos flechas de
       seguimiento y el aviso — y las flechas casi nunca existen las
       dos, porque bloqueas a gente que no te sigue. Con una sola
       operación denegada cae el lote entero: bloquear devolvía «no se
       pudo, inténtalo otra vez» y no se podía nunca.

       Se descubrió corriendo el código real de la app contra el
       emulador (`npm run test:circuito`), no leyendo el fichero.

       Permitirlo no abre nada: donde no hay documento no hay dato que
       proteger, y el borrado no deja nada escrito. */
    function noHayNada() {
      return resource == null;
    }

    // Cada quien manda sobre lo suyo, y solo sobre lo suyo.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /books/{bookId} {
        allow read, write: if isOwner(userId);
      }

      // Cualquier subcolección futura hereda la misma regla por defecto
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    /* ── RESEÑAS PUBLICADAS  ·  historia #28 ──────────────────
       Las reglas de Firestore conceden documentos ENTEROS: no existe
       «puede leer este documento pero no el campo `review`». Por eso
       una reseña pública no puede ser un campo dentro del libro —
       abrirlo para que otra persona lea la reseña lo abriría con todo
       lo demás dentro.

       Así que publicar es copiar aquí. A esta colección solo llega lo
       que se marcó como público, y con lo justo (ver reviews-core.js:
       título, autor, texto, puntuación y de quién es). Lo privado
       nunca sale de users/{uid}, donde nadie más entra.

       Escribe solo su dueña, y la ruta lo demuestra: el {userId} del
       camino tiene que ser el de quien escribe. */
    match /reviews/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);

      match /entries/{bookId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }
    }

    /* ── EL @USUARIO  ·  historia #44 ─────────────────────────
       Un documento por nombre: usernames/{nombre} → {uid}.

       Estuvo en `social/usernames/{nombre}`, que no era un documento
       sino una colección: en Firestore las rutas alternan colección y
       documento, así que un documento tiene siempre un número PAR de
       segmentos, y aquél tenía tres. Ni el cliente podía escribirlo ni
       esta regla podía casar con nada.

       AQUÍ ES DONDE VIVE LA UNICIDAD, y no en el cliente. Comprobar
       si está libre y escribirlo son dos momentos distintos, y entre
       uno y otro cabe perfectamente otra persona. Por eso solo se
       permite `create`: en Firestore un create sobre un documento que
       YA EXISTE falla, sin carrera posible. Y `update` está prohibido
       del todo, así que nadie puede escribir encima del nombre de
       otra persona ni por error ni a propósito.

       El {nombre} del camino va siempre en minúsculas y la regla lo
       exige: si «Laura» y «laura» fueran dos documentos, serían dos
       cuentas distintas para quien te busca, que es la suplantación
       más barata que existe.

       Los reservados también se comprueban aquí. Una lista que solo
       vive en el cliente la salta cualquiera con la consola abierta,
       y quien se llame «soporte» puede pedir contraseñas. */
    function nombreDeUsuarioValido(u) {
      return u.matches('^[a-z0-9_.]{3,20}$')
        && !u.matches('^[.].*')
        && !u.matches('.*[.]$')
        && !u.matches('.*[.][.].*')
        && !(u in ['admin', 'administrador', 'soporte', 'support', 'ayuda', 'help',
                   'root', 'sistema', 'system', 'oficial', 'staff', 'moderador',
                   'mibiblioteca', 'biblioteca', 'app', 'api', 'www', 'about', 'acerca',
                   'ajustes', 'settings', 'perfil', 'profile', 'buscar', 'search',
                   'nuevo', 'new', 'null', 'undefined', 'anonimo', 'anonymous']);
    }

    /* ── EL PERFIL PÚBLICO  ·  historia #45 ───────────────────
       Otra vez lo mismo, y por lo mismo: users/{uid} lleva dentro tus
       ajustes, tus metas, tus días de lectura y tus reseñas privadas.
       Abrirlo para que se vea tu nombre lo abriría entero.

       Así que el perfil público es una COPIA aquí, con lo justo (ver
       profile-core.js). Lo lee cualquiera con sesión; lo escribe solo
       su dueña, y el {userId} del camino tiene que ser el de quien
       escribe — igual que en las reseñas.

       El `uid` de dentro también se comprueba: si no coincidiera con
       el del camino, un perfil podría decir que es de otra persona, y
       tanto seguir como buscar se guían por ese campo. */
    /* SE LEE SIN SESIÓN, y es una decisión, no un descuido.

       La historia #48 pide que quien abra tu link SIN TENER LA APP
       llegue a tu perfil. Un perfil «público» que exige crearse una
       cuenta para verlo no es público: es justo la puerta cerrada que
       hace que nadie pulse el link que acabas de mandar por WhatsApp.

       Lo que hay aquí dentro es exactamente lo que su dueña decidió
       publicar, sección por sección (ver profile-core.js), y por eso
       se puede abrir: si no querías que se viera, no está en el
       documento. Lo privado sigue en users/{uid}, donde no entra nadie.

       El coste real es que se puede recorrer desde fuera. Es el mismo
       trato que hace cualquier red social con los perfiles públicos, y
       la defensa es la de siempre: que lo público lo elija cada quien.
       Para quien no quiera nada de esto está la cuenta privada (#52). */
    match /profiles/{userId} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && request.resource.data.uid == userId;

      /* ── CUENTA PRIVADA  ·  historia #52 ────────────────────
         Con la cuenta privada, quien no te sigue ve solo tu tarjeta
         —nombre, avatar y bio—, que es el documento de arriba. Todo
         lo demás vive AQUÍ, y aquí solo entra quien te sigue.

         Es la única forma de cumplirlo: las reglas conceden documentos
         enteros, así que «esto sí y esto no» dentro del mismo
         documento no existe. Tiene que ser otro documento con otra
         regla, y esta es esa regla. */
      match /full/{doc} {
        allow read: if isOwner(userId)
                    || (request.auth != null
                        && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId)));
        allow write: if isOwner(userId);
      }
    }

    /* ── SOLICITUDES DE SEGUIMIENTO  ·  historia #52 ──────────
         El identificador es {aQuien}_{quienPide}. Las ve las dos: quien
         pide, para saber que está pendiente, y quien recibe, para
         aceptarla. Nadie más — a quién intenta seguir cada quien no es
         asunto público.

         Cancelar puede quien pidió; rechazar, quien recibe. Los dos
         borran el mismo documento y por eso las dos pueden. */
    match /followRequests/{reqId} {
      allow read: if request.auth != null
                  && (resource.data.de == request.auth.uid
                      || resource.data.a == request.auth.uid);
      allow delete: if request.auth != null
                    && (noHayNada()
                        || resource.data.de == request.auth.uid
                        || resource.data.a == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && reqId == request.resource.data.a + '_' + request.auth.uid
                    && request.resource.data.a != request.auth.uid;
      allow update: if false;
    }

    match /usernames/{username} {
      /* Se lee sin sesión por lo mismo que el perfil: un link
         `#/u/laura` no se puede resolver sin traducir el nombre a un
         uid, y quien lo abre todavía no tiene cuenta. Lo único que hay
         aquí es esa traducción — un nombre y un uid—, que es
         exactamente lo que ya se ve en el link. */
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && nombreDeUsuarioValido(username);

      // Soltarlo es solo cosa de su dueña — al cambiarlo o al borrar la cuenta
      allow delete: if request.auth != null
                    && (noHayNada() || resource.data.uid == request.auth.uid);

      // Nunca. Un nombre tomado no se sobrescribe, se suelta y se vuelve a pedir
      allow update: if false;
    }

    /* ── SEGUIR  ·  historia #46 ──────────────────────────────
       Un documento por FLECHA, no por pareja: seguir es asimétrico.
       El identificador es `{quienSigue}_{aQuienSigue}`, y la regla
       EXIGE que el camino y el contenido digan lo mismo. Sin eso, yo
       podría crear `ana_bea` con follower «bea» y aparecer en las
       listas de otras dos personas que no me han seguido.

       Solo puede crear y borrar la flecha quien sigue. Que te sigan no
       te deja borrarlo: para eso está bloquear (#51), que es otra cosa
       y se hace explícitamente. `update` no existe — una flecha no se
       edita, se crea o se borra. */
    match /follows/{followId} {
      allow read: if request.auth != null;

      /* Dos caminos, y hacen falta los dos (historia #52):

         1. LA CUENTA ES PÚBLICA → la sigo yo, sin pedir permiso.
         2. LA CUENTA ES PRIVADA → la flecha la escribe LA DUEÑA al
            aceptar, y solo si existe la solicitud. Por eso el segundo
            camino permite crear una flecha que apunta a una misma:
            es literalmente «acepto que me sigas».

         Sin el segundo camino, aceptar una solicitud sería imposible;
         sin el primero, seguir a nadie lo sería. */
      allow create: if request.auth != null
                    && followId == request.resource.data.follower + '_' + request.resource.data.following
                    && request.resource.data.following != request.resource.data.follower
                    && (
                      (request.resource.data.follower == request.auth.uid
                       && !esPrivada(request.resource.data.following))
                      ||
                      (request.resource.data.following == request.auth.uid
                       && exists(/databases/$(database)/documents/followRequests/$(request.auth.uid + '_' + request.resource.data.follower)))
                    );

      /* Quien sigue puede dejar de seguir, y quien es seguida puede
         QUITARSE UNA SEGUIDORA sin bloquearla — lo pide la #52, y es
         una cosa que suele faltar: si lo único que puedes hacer es
         bloquear, no quitas a nadie. */
      allow delete: if request.auth != null
                    && (noHayNada()
                        || resource.data.follower == request.auth.uid
                        || resource.data.following == request.auth.uid);

      allow update: if false;
    }

    /* ── LOS AVISOS  ·  historia #46 ──────────────────────────
       La bandeja de cada quien, en su propio sitio: notifs/{uid}/items.

       AQUÍ HAY QUE ESCRIBIR EN CASA AJENA, y no hay forma de evitarlo
       sin un servidor propio: para avisarte de que te sigo, el aviso
       tiene que aparecer en TU bandeja y lo escribo yo. Así que la
       regla aprieta todo lo demás:

       - el `from` tiene que ser quien escribe, así que nadie puede
         dejar avisos firmados por otra persona;
       - el identificador es `follow_{quienSigue}`, así que seguir y
         dejar de seguir mil veces deja UN aviso, no mil: no se puede
         usar para inundar la bandeja de nadie;
       - solo la dueña puede leerlos y marcarlos como leídos. Quien
         avisa no puede volver a mirar lo que hay dentro.

       Borrar lo puede hacer la dueña, y también quien lo dejó — que es
       lo que permite retirar el aviso al dejar de seguir. */
    match /notifs/{userId}/items/{noticeId} {
      allow read: if isOwner(userId);

      /* Dos clases de aviso, y las dos con el MISMO tope: un documento
         por persona que avisa. Seguir mil veces deja un aviso, y
         comentar mil veces deja un aviso — el último, que es el que
         se quiere ver.

         El aviso de comentario llevaba dentro el sitio comentado
         (`comment_{quien}_{target}`) y el `target` es texto libre, así
         que cualquiera podía escribir avisos distintos hasta llenar
         una bandeja ajena. Con el identificador cerrado no se puede:
         el precio es que dos comentarios seguidos de la misma persona
         se ven como uno, y ese precio se paga con gusto.

         Sin esta línea el aviso de comentario NO EXISTÍA: la regla solo
         casaba con `follow_`, así que la escritura la rechazaba el
         servidor y nadie se enteraba nunca de un comentario suyo. */
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && (noticeId == 'follow_' + request.auth.uid
                        || noticeId == 'comment_' + request.auth.uid
                        || noticeId == 'swapreq_' + request.auth.uid
                        || noticeId == 'swapres_' + request.auth.uid)
                    && userId != request.auth.uid;

      /* La dueña, para marcarlo leído; y quien lo dejó, para
         refrescarlo. Lo segundo hace falta porque el identificador es
         fijo: el segundo comentario de la misma persona no crea un
         aviso nuevo, sobrescribe el suyo — y sin esto, ese segundo
         aviso lo rechazaba el servidor y solo llegaba el primero. */
      allow update: if (isOwner(userId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['leido']))
                    || (request.auth != null
                        && resource.data.from == request.auth.uid
                        && request.resource.data.from == request.auth.uid
                        && (noticeId == 'follow_' + request.auth.uid
                            || noticeId == 'comment_' + request.auth.uid
                            || noticeId == 'swapreq_' + request.auth.uid
                            || noticeId == 'swapres_' + request.auth.uid));

      allow delete: if isOwner(userId)
                    || (request.auth != null
                        && (noHayNada() || resource.data.from == request.auth.uid));
    }

    /* ── LA ACTIVIDAD DEL FEED  ·  historia #49 ───────────────
       ESTA REGLA NO EXISTÍA. La app escribía en `activity` desde que se
       hizo el feed y la última regla del fichero —«todo lo demás,
       cerrado»— lo denegaba todo: ni una sola entrada llegó nunca a
       guardarse, así que el feed estaba vacío por definición y no por
       falta de gente. Se descubrió pasando las rutas que usa el código
       por el emulador de Firestore, no leyendo.

       Es una copia pública con lo justo, como el perfil y las reseñas
       (ver feed-core.js): quién, qué tipo, el libro y poco más. Lo lee
       cualquiera con sesión porque el feed se arma al vuelo leyendo la
       actividad de a quién sigues, y filtrar por seguidoras dentro de
       la regla exigiría una lectura por entrada.

       Lo que la regla sí aprieta:

       - el `uid` de dentro tiene que ser quien escribe, así que nadie
         publica actividad firmada por otra persona — que es lo único
         que de verdad importa aquí, porque el feed se guía por ese
         campo;
       - el identificador tiene que empezar por tu uid, así que cada
         quien escribe en su propio trozo del espacio de nombres y no
         puede pisar el de nadie. Se compara cortando la cadena y no
         con una expresión regular, para no meter el uid dentro de un
         patrón. */
    match /activity/{activityId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && activityId.size() > request.auth.uid.size()
                            && activityId[0:request.auth.uid.size()] == request.auth.uid;

      allow delete: if request.auth != null
                    && (noHayNada() || resource.data.uid == request.auth.uid);
    }

    /* ── BLOQUEAR Y SILENCIAR  ·  historia #51 ────────────────
       Tu lista es tuya: solo tú la lees y solo tú la escribes. Que
       alguien pueda consultar si le has bloqueado sería decirle
       exactamente lo que no quieres decirle.

       La excepción es la lectura DIRIGIDA que hacen las reglas de
       abajo con `exists()`, que no pasa por el cliente. */
    match /blocks/{blockId} {
      allow read: if request.auth != null
                  && (resource.data.de == request.auth.uid
                      || resource.data.a == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && blockId == request.auth.uid + '_' + request.resource.data.a
                    && request.resource.data.a != request.auth.uid;
      allow delete: if request.auth != null
                    && (noHayNada() || resource.data.de == request.auth.uid);
      allow update: if false;
    }

    match /mutes/{muteId} {
      // Silenciar no se lo cuenta a nadie, ni siquiera a quien silencias
      allow read: if request.auth != null && resource.data.de == request.auth.uid;
      allow delete: if request.auth != null
                    && (noHayNada() || resource.data.de == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && muteId == request.auth.uid + '_' + request.resource.data.a;
      allow update: if false;
    }

    function meBloqueo(otra) {
      return exists(/databases/$(database)/documents/blocks/$(otra + '_' + request.auth.uid));
    }

    /* ── COMENTARIOS  ·  historia #50 ─────────────────────────
       EL BLOQUEO SE APLICA AQUÍ, no solo en la pantalla. Filtrar en el
       cliente hace que no la veas —que ya es lo que pides—, pero no
       impide que ella te escriba, y eso es lo que de verdad hace falta
       cuando alguien te está molestando. La comprobación cuesta una
       lectura por comentario y los vale.

       Borrar lo puede hacer quien lo escribió Y la dueña del sitio
       donde está: por eso el comentario lleva dentro `targetOwner`, y
       por eso la regla exige al crearlo que ese campo no se lo invente
       quien comenta... salvo que sea suyo. Sin eso, cualquiera podría
       ponerse como dueña de los comentarios de otra.

       `update` no existe: un comentario editado después de que alguien
       lo haya leído —o reportado— es otra cosa distinta. Se borra y se
       escribe de nuevo. */
    match /comments/{target}/items/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.target == target
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 500
                    && !meBloqueo(request.resource.data.targetOwner);

      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || resource.data.targetOwner == request.auth.uid);

      allow update: if false;
    }

    /* Las reacciones de una publicación, todas en un documento
       {uid: emoji}. Cada quien solo puede tocar SU entrada: la regla
       comprueba que lo que cambia sea únicamente la clave con tu uid.
       Sin eso, cualquiera podría borrar las reacciones de los demás. */
    match /reactions/{target} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.de.diff(
                        resource == null ? {} : resource.data.de
                      ).affectedKeys().hasOnly([request.auth.uid]);
    }

    /* ── REPORTES  ·  historia #51 ────────────────────────────
       SE ESCRIBEN Y NO SE LEEN. Si se pudieran leer desde la app,
       cualquiera podría enterarse de quién ha reportado a quién, que es
       la forma más rápida de que reportar deje de usarse. La cola de
       revisión se mira desde la consola de Firebase, fuera de la app.

       Tampoco se pueden borrar ni editar: un reporte que quien acosa
       puede hacer desaparecer no sirve de nada. */
    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && request.resource.data.estado == 'pendiente';
      allow update, delete: if false;
    }

    /* ── INTERCAMBIO  ·  historias #81, #82, #89 ──────────────
       Las publicaciones las lee cualquiera con sesión: para eso están,
       para que alguien de tu ciudad encuentre tu libro. Explorar no
       pide nada más — la barrera de la #89 es solo para PUBLICAR.

       LO QUE NO PUEDE ENTRAR AQUÍ ES DÓNDE VIVES. La regla lo exige
       campo a campo: hay ciudad, y no hay ni `lat`, ni `lon`, ni
       `address`, ni un geohash más largo del pactado. Está en el
       cliente (place-core.js) y está aquí, porque el cliente se puede
       modificar y esto no.

       TAMPOCO HAY PRECIO. Es trueque: meter dinero abriría requisitos
       legales y de tienda mucho mayores y, sobre todo, la puerta a las
       estafas. Un campo de precio se rechaza aunque alguien lo mande.

       El correo verificado se comprueba con el token, que lo trae
       firmado por Google: es lo único de la #89 que el cliente no
       podría saltarse solo. Los días de cuenta y los libros
       registrados se comprueban en la app — son un filtro contra
       cuentas desechables, no una barrera de seguridad. */
    match /swaps/{swapId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.city is string
                    && request.resource.data.city.size() > 0
                    && !('lat' in request.resource.data)
                    && !('lon' in request.resource.data)
                    && !('address' in request.resource.data)
                    && !('precio' in request.resource.data)
                    && !('price' in request.resource.data)
                    && (request.resource.data.geohash == null
                        || request.resource.data.geohash.size() <= 6);

      /* Solo su dueña la toca, y el uid no se puede cambiar: si se
         pudiera, se podría regalar una publicación a otra cuenta. */
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && !('lat' in request.resource.data)
                    && !('lon' in request.resource.data)
                    && !('precio' in request.resource.data);

      allow delete: if request.auth != null
                    && (noHayNada() || resource.data.uid == request.auth.uid);
    }

    /* ── SOLICITUDES DE INTERCAMBIO  ·  historia #84 ──────────
       Las publicaciones son públicas a propósito; esto NO. A quién le
       pides un libro no es asunto de nadie más, así que solo la leen
       las dos personas implicadas.

       EL IDENTIFICADOR ES `{quienPide}_{publicación}`, y ahí está la
       defensa contra el spam: dos solicitudes de la misma persona
       sobre el mismo libro son el mismo documento, así que no se
       pueden apilar. El tope diario de la historia vive en la app —
       contar documentos dentro de una regla no se puede, y decirlo es
       más honesto que fingir que esto lo cubre.

       LA MÁQUINA DE ESTADOS ESTÁ AQUÍ, no solo en el cliente. Quien
       recibe contesta mientras está pendiente; quien pidió cierra la
       contrapropuesta o retira la suya. Sin esto, cualquiera de las
       dos podría marcar como «aceptada» una solicitud que la otra
       nunca aceptó — y aceptar es lo que abre el chat y lleva a un
       encuentro en persona.

       Y SIGUE SIN HABER DINERO, igual que en las publicaciones: un
       campo de precio se rechaza aunque alguien lo mande a mano. */
    match /swapRequests/{reqId} {
      function soyParte() {
        return request.auth != null
               && (resource.data.de == request.auth.uid
                   || resource.data.para == request.auth.uid);
      }
      function sinDinero(d) {
        return !('precio' in d) && !('price' in d) && !('pago' in d);
      }

      allow read: if soyParte();

      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && request.resource.data.para != request.auth.uid
                    && reqId == request.auth.uid + '_' + request.resource.data.swapId
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.mensaje.size() <= 300
                    && request.resource.data.ofrezco.size() <= 3
                    && sinDinero(request.resource.data);

      /* Ni el `de`, ni el `para`, ni de qué libro se habla cambian
         nunca: una solicitud es entre esas dos personas y sobre ese
         libro, y poder cambiarlo sería poder colar una conversación
         ajena en la bandeja de alguien. */
      allow update: if soyParte()
                    && request.resource.data.de == resource.data.de
                    && request.resource.data.para == resource.data.para
                    && request.resource.data.swapId == resource.data.swapId
                    && sinDinero(request.resource.data)
                    && (
                      (request.auth.uid == resource.data.para
                       && resource.data.estado == 'pendiente'
                       && request.resource.data.estado in ['aceptada', 'rechazada', 'contrapropuesta'])
                      ||
                      (request.auth.uid == resource.data.de
                       && ((resource.data.estado == 'contrapropuesta'
                            && request.resource.data.estado in ['aceptada', 'rechazada'])
                           || (resource.data.estado in ['pendiente', 'contrapropuesta']
                               && request.resource.data.estado == 'cancelada')))
                    );

      allow delete: if request.auth != null
                    && (noHayNada()
                        || resource.data.de == request.auth.uid
                        || resource.data.para == request.auth.uid);
    }

    /* ── EL CHAT DEL INTERCAMBIO  ·  historias #85 y #88 ──────
       Aquí es donde dos desconocidas quedan en persona, así que esta
       regla es la más estricta del fichero.

       SOLO LAS DOS PARTES, y ni siquiera se puede saber que un chat
       existe desde fuera. `partes` va ordenado y no se puede cambiar:
       si se pudiera, alguien podría meterse en una conversación ajena
       añadiéndose a la lista.

       EL CHAT SOLO SE ABRE SOBRE UNA SOLICITUD ACEPTADA. Cuesta una
       lectura y la vale: sin esto, cualquiera podría abrirle un chat a
       cualquiera y esto sería una bandeja de mensajes no pedidos. La
       solicitud dice quién pidió, a quién, y si aceptó.

       BLOQUEAR CIERRA EL CHAT POR LOS DOS LADOS, y eso es lo que pide
       la historia. Si solo se cerrara por un lado, quien bloquea
       seguiría recibiendo — que es justo lo que se quiere evitar. */
    match /chats/{chatId} {
      /* `noHayNada()` también al LEER, y por lo mismo que al borrar:
         preguntar por un chat que todavía no existe deja `resource` a
         null, y leer `resource.data.partes` sobre null revienta la
         evaluación — con lo que abrir un chat por primera vez era
         imposible, porque lo primero que hace es mirar si ya está.

         Dejar leer lo que no existe no enseña nada: no hay documento
         que enseñar. */
      function esParte() {
        return request.auth != null
               && (noHayNada() || request.auth.uid in resource.data.partes);
      }
      function solicitudAceptada() {
        return exists(/databases/$(database)/documents/swapRequests/$(chatId))
          && get(/databases/$(database)/documents/swapRequests/$(chatId)).data.estado == 'aceptada'
          && request.auth.uid in [
            get(/databases/$(database)/documents/swapRequests/$(chatId)).data.de,
            get(/databases/$(database)/documents/swapRequests/$(chatId)).data.para,
          ];
      }

      allow read: if esParte();

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.partes
                    && request.resource.data.partes.size() == 2
                    && solicitudAceptada();

      /* Se actualiza para confirmar, para cerrar y para marcar que ya
         se leyeron los avisos. Lo que NUNCA cambia es quiénes son las
         dos partes ni de qué intercambio se habla.

         Aquí NO vale el `noHayNada()` de `esParte()`: sobre un
         documento que existe, `resource` existe, y exigirlo es lo que
         impide que alguien de fuera toque un chat ajeno. */
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.partes
                    && request.resource.data.partes == resource.data.partes
                    && request.resource.data.solicitudId == resource.data.solicitudId;

      allow delete: if false;

      /* ── LOS MENSAJES ───────────────────────────────────────
         Escribe solo quien es parte, firmando con su propio uid, y
         solo si la otra no le ha bloqueado. Un mensaje no se edita ni
         se borra: una conversación que se puede reescribir después no
         sirve para reportar a nadie, y reportar es la salida cuando
         algo va mal. */
      match /mensajes/{mensajeId} {
        function partesDelChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.partes;
        }
        function otraParte() {
          return partesDelChat()[0] == request.auth.uid
            ? partesDelChat()[1] : partesDelChat()[0];
        }

        allow read: if request.auth != null && request.auth.uid in partesDelChat();

        allow create: if request.auth != null
                      && request.auth.uid in partesDelChat()
                      && request.resource.data.de == request.auth.uid
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 1000
                      && !meBloqueo(otraParte())
                      && get(/databases/$(database)/documents/chats/$(chatId)).data.get('cerrado', false) == false;

        allow update, delete: if false;
      }
    }

    /* ── LAS VALORACIONES  ·  historia #86 ────────────────────
       SE LEEN PÚBLICAMENTE Y SE ESCRIBEN CASI NUNCA. La reputación
       solo sirve si quien está decidiendo si queda contigo la puede
       ver antes de decidirlo; por eso se lee con sesión y sin más.

       NO SE PUEDE VALORAR SIN HABER INTERCAMBIADO, y se comprueba
       aquí: una valoración que cualquiera puede escribir sobre
       cualquiera no es reputación, es un tablón de insultos. El
       identificador es `{chat}_{quienValora}`, así que cada persona
       deja como mucho UNA valoración por intercambio.

       Y no se editan ni se borran: una valoración que quien la recibe
       puede hacer desaparecer no vale nada, y una que quien la
       escribió puede cambiar después convierte esto en una moneda de
       cambio. */
    match /swapRatings/{ratingId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && request.resource.data.sobre != request.auth.uid
                    && ratingId == request.resource.data.chatIdent + '_' + request.auth.uid
                    && request.resource.data.puntualidad >= 1
                    && request.resource.data.puntualidad <= 5
                    && request.resource.data.estado >= 1
                    && request.resource.data.estado <= 5
                    && request.resource.data.trato >= 1
                    && request.resource.data.trato <= 5
                    && request.resource.data.comentario.size() <= 300
                    // El intercambio existe, se completó, y las dos son parte
                    && exists(/databases/$(database)/documents/chats/$(request.resource.data.chatIdent))
                    && get(/databases/$(database)/documents/chats/$(request.resource.data.chatIdent)).data.completado == true
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatIdent)).data.partes
                    && request.resource.data.sobre in get(/databases/$(database)/documents/chats/$(request.resource.data.chatIdent)).data.partes;

      allow update, delete: if false;
    }

    /* La colección `biblioteca` era de la época sin autenticación.
       Estuvo abierta a cualquier cuenta con sesión para poder migrarla
       una vez — lo que significaba que CUALQUIER usuaria podía leer y
       borrar esa biblioteca. Eso fue un error: la migración ya ocurrió,
       así que la puerta se cierra del todo.

       Si alguna vez hiciera falta reabrirla, hay que acotarla al dueño,
       nunca a "cualquiera con sesión". */

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
