rules_version = '2';

/* ─────────────────────────────────────────────────────────────
   REGLAS DE SEGURIDAD  ·  historia #18

   PARA DESPLEGARLAS:
     npx firebase-tools deploy --only firestore:rules

   Mientras no se desplieguen, la base queda como esté ahora.
   ───────────────────────────────────────────────────────────── */

service cloud.firestore {
  match /databases/{database}/documents {

    /* Mirar si una cuenta es privada cuesta una lectura, y solo se
       paga al crear una flecha de seguimiento — no en cada consulta. */
    function esPrivada(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId))
        && get(/databases/$(database)/documents/profiles/$(userId)).data.privada == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Cada quien manda sobre lo suyo, y solo sobre lo suyo.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /books/{bookId} {
        allow read, write: if isOwner(userId);
      }

      // Cualquier subcolección futura hereda la misma regla por defecto
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    /* ── RESEÑAS PUBLICADAS  ·  historia #28 ──────────────────
       Las reglas de Firestore conceden documentos ENTEROS: no existe
       «puede leer este documento pero no el campo `review`». Por eso
       una reseña pública no puede ser un campo dentro del libro —
       abrirlo para que otra persona lea la reseña lo abriría con todo
       lo demás dentro.

       Así que publicar es copiar aquí. A esta colección solo llega lo
       que se marcó como público, y con lo justo (ver reviews-core.js:
       título, autor, texto, puntuación y de quién es). Lo privado
       nunca sale de users/{uid}, donde nadie más entra.

       Escribe solo su dueña, y la ruta lo demuestra: el {userId} del
       camino tiene que ser el de quien escribe. */
    match /reviews/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);

      match /entries/{bookId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }
    }

    /* ── EL @USUARIO  ·  historia #44 ─────────────────────────
       Un documento por nombre: usernames/{nombre} → {uid}.

       Estuvo en `social/usernames/{nombre}`, que no era un documento
       sino una colección: en Firestore las rutas alternan colección y
       documento, así que un documento tiene siempre un número PAR de
       segmentos, y aquél tenía tres. Ni el cliente podía escribirlo ni
       esta regla podía casar con nada.

       AQUÍ ES DONDE VIVE LA UNICIDAD, y no en el cliente. Comprobar
       si está libre y escribirlo son dos momentos distintos, y entre
       uno y otro cabe perfectamente otra persona. Por eso solo se
       permite `create`: en Firestore un create sobre un documento que
       YA EXISTE falla, sin carrera posible. Y `update` está prohibido
       del todo, así que nadie puede escribir encima del nombre de
       otra persona ni por error ni a propósito.

       El {nombre} del camino va siempre en minúsculas y la regla lo
       exige: si «Laura» y «laura» fueran dos documentos, serían dos
       cuentas distintas para quien te busca, que es la suplantación
       más barata que existe.

       Los reservados también se comprueban aquí. Una lista que solo
       vive en el cliente la salta cualquiera con la consola abierta,
       y quien se llame «soporte» puede pedir contraseñas. */
    function nombreDeUsuarioValido(u) {
      return u.matches('^[a-z0-9_.]{3,20}$')
        && !u.matches('^[.].*')
        && !u.matches('.*[.]$')
        && !u.matches('.*[.][.].*')
        && !(u in ['admin', 'administrador', 'soporte', 'support', 'ayuda', 'help',
                   'root', 'sistema', 'system', 'oficial', 'staff', 'moderador',
                   'mibiblioteca', 'biblioteca', 'app', 'api', 'www', 'about', 'acerca',
                   'ajustes', 'settings', 'perfil', 'profile', 'buscar', 'search',
                   'nuevo', 'new', 'null', 'undefined', 'anonimo', 'anonymous']);
    }

    /* ── EL PERFIL PÚBLICO  ·  historia #45 ───────────────────
       Otra vez lo mismo, y por lo mismo: users/{uid} lleva dentro tus
       ajustes, tus metas, tus días de lectura y tus reseñas privadas.
       Abrirlo para que se vea tu nombre lo abriría entero.

       Así que el perfil público es una COPIA aquí, con lo justo (ver
       profile-core.js). Lo lee cualquiera con sesión; lo escribe solo
       su dueña, y el {userId} del camino tiene que ser el de quien
       escribe — igual que en las reseñas.

       El `uid` de dentro también se comprueba: si no coincidiera con
       el del camino, un perfil podría decir que es de otra persona, y
       tanto seguir como buscar se guían por ese campo. */
    /* SE LEE SIN SESIÓN, y es una decisión, no un descuido.

       La historia #48 pide que quien abra tu link SIN TENER LA APP
       llegue a tu perfil. Un perfil «público» que exige crearse una
       cuenta para verlo no es público: es justo la puerta cerrada que
       hace que nadie pulse el link que acabas de mandar por WhatsApp.

       Lo que hay aquí dentro es exactamente lo que su dueña decidió
       publicar, sección por sección (ver profile-core.js), y por eso
       se puede abrir: si no querías que se viera, no está en el
       documento. Lo privado sigue en users/{uid}, donde no entra nadie.

       El coste real es que se puede recorrer desde fuera. Es el mismo
       trato que hace cualquier red social con los perfiles públicos, y
       la defensa es la de siempre: que lo público lo elija cada quien.
       Para quien no quiera nada de esto está la cuenta privada (#52). */
    match /profiles/{userId} {
      allow read: if true;
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && request.resource.data.uid == userId;

      /* ── CUENTA PRIVADA  ·  historia #52 ────────────────────
         Con la cuenta privada, quien no te sigue ve solo tu tarjeta
         —nombre, avatar y bio—, que es el documento de arriba. Todo
         lo demás vive AQUÍ, y aquí solo entra quien te sigue.

         Es la única forma de cumplirlo: las reglas conceden documentos
         enteros, así que «esto sí y esto no» dentro del mismo
         documento no existe. Tiene que ser otro documento con otra
         regla, y esta es esa regla. */
      match /full/{doc} {
        allow read: if isOwner(userId)
                    || (request.auth != null
                        && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId)));
        allow write: if isOwner(userId);
      }
    }

    /* ── SOLICITUDES DE SEGUIMIENTO  ·  historia #52 ──────────
         El identificador es {aQuien}_{quienPide}. Las ve las dos: quien
         pide, para saber que está pendiente, y quien recibe, para
         aceptarla. Nadie más — a quién intenta seguir cada quien no es
         asunto público.

         Cancelar puede quien pidió; rechazar, quien recibe. Los dos
         borran el mismo documento y por eso las dos pueden. */
    match /followRequests/{reqId} {
      allow read, delete: if request.auth != null
                          && (resource.data.de == request.auth.uid
                              || resource.data.a == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && reqId == request.resource.data.a + '_' + request.auth.uid
                    && request.resource.data.a != request.auth.uid;
      allow update: if false;
    }

    match /usernames/{username} {
      /* Se lee sin sesión por lo mismo que el perfil: un link
         `#/u/laura` no se puede resolver sin traducir el nombre a un
         uid, y quien lo abre todavía no tiene cuenta. Lo único que hay
         aquí es esa traducción — un nombre y un uid—, que es
         exactamente lo que ya se ve en el link. */
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && nombreDeUsuarioValido(username);

      // Soltarlo es solo cosa de su dueña — al cambiarlo o al borrar la cuenta
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // Nunca. Un nombre tomado no se sobrescribe, se suelta y se vuelve a pedir
      allow update: if false;
    }

    /* ── SEGUIR  ·  historia #46 ──────────────────────────────
       Un documento por FLECHA, no por pareja: seguir es asimétrico.
       El identificador es `{quienSigue}_{aQuienSigue}`, y la regla
       EXIGE que el camino y el contenido digan lo mismo. Sin eso, yo
       podría crear `ana_bea` con follower «bea» y aparecer en las
       listas de otras dos personas que no me han seguido.

       Solo puede crear y borrar la flecha quien sigue. Que te sigan no
       te deja borrarlo: para eso está bloquear (#51), que es otra cosa
       y se hace explícitamente. `update` no existe — una flecha no se
       edita, se crea o se borra. */
    match /follows/{followId} {
      allow read: if request.auth != null;

      /* Dos caminos, y hacen falta los dos (historia #52):

         1. LA CUENTA ES PÚBLICA → la sigo yo, sin pedir permiso.
         2. LA CUENTA ES PRIVADA → la flecha la escribe LA DUEÑA al
            aceptar, y solo si existe la solicitud. Por eso el segundo
            camino permite crear una flecha que apunta a una misma:
            es literalmente «acepto que me sigas».

         Sin el segundo camino, aceptar una solicitud sería imposible;
         sin el primero, seguir a nadie lo sería. */
      allow create: if request.auth != null
                    && followId == request.resource.data.follower + '_' + request.resource.data.following
                    && request.resource.data.following != request.resource.data.follower
                    && (
                      (request.resource.data.follower == request.auth.uid
                       && !esPrivada(request.resource.data.following))
                      ||
                      (request.resource.data.following == request.auth.uid
                       && exists(/databases/$(database)/documents/followRequests/$(request.auth.uid + '_' + request.resource.data.follower)))
                    );

      /* Quien sigue puede dejar de seguir, y quien es seguida puede
         QUITARSE UNA SEGUIDORA sin bloquearla — lo pide la #52, y es
         una cosa que suele faltar: si lo único que puedes hacer es
         bloquear, no quitas a nadie. */
      allow delete: if request.auth != null
                    && (resource.data.follower == request.auth.uid
                        || resource.data.following == request.auth.uid);

      allow update: if false;
    }

    /* ── LOS AVISOS  ·  historia #46 ──────────────────────────
       La bandeja de cada quien, en su propio sitio: notifs/{uid}/items.

       AQUÍ HAY QUE ESCRIBIR EN CASA AJENA, y no hay forma de evitarlo
       sin un servidor propio: para avisarte de que te sigo, el aviso
       tiene que aparecer en TU bandeja y lo escribo yo. Así que la
       regla aprieta todo lo demás:

       - el `from` tiene que ser quien escribe, así que nadie puede
         dejar avisos firmados por otra persona;
       - el identificador es `follow_{quienSigue}`, así que seguir y
         dejar de seguir mil veces deja UN aviso, no mil: no se puede
         usar para inundar la bandeja de nadie;
       - solo la dueña puede leerlos y marcarlos como leídos. Quien
         avisa no puede volver a mirar lo que hay dentro.

       Borrar lo puede hacer la dueña, y también quien lo dejó — que es
       lo que permite retirar el aviso al dejar de seguir. */
    match /notifs/{userId}/items/{noticeId} {
      allow read: if isOwner(userId);

      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && noticeId == 'follow_' + request.auth.uid
                    && userId != request.auth.uid;

      // Solo la dueña, y solo para marcarlo leído
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['leido']);

      allow delete: if isOwner(userId)
                    || (request.auth != null && resource.data.from == request.auth.uid);
    }

    /* ── BLOQUEAR Y SILENCIAR  ·  historia #51 ────────────────
       Tu lista es tuya: solo tú la lees y solo tú la escribes. Que
       alguien pueda consultar si le has bloqueado sería decirle
       exactamente lo que no quieres decirle.

       La excepción es la lectura DIRIGIDA que hacen las reglas de
       abajo con `exists()`, que no pasa por el cliente. */
    match /blocks/{blockId} {
      allow read: if request.auth != null
                  && (resource.data.de == request.auth.uid
                      || resource.data.a == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && blockId == request.auth.uid + '_' + request.resource.data.a
                    && request.resource.data.a != request.auth.uid;
      allow delete: if request.auth != null && resource.data.de == request.auth.uid;
      allow update: if false;
    }

    match /mutes/{muteId} {
      // Silenciar no se lo cuenta a nadie, ni siquiera a quien silencias
      allow read, delete: if request.auth != null && resource.data.de == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && muteId == request.auth.uid + '_' + request.resource.data.a;
      allow update: if false;
    }

    function meBloqueo(otra) {
      return exists(/databases/$(database)/documents/blocks/$(otra + '_' + request.auth.uid));
    }

    /* ── COMENTARIOS  ·  historia #50 ─────────────────────────
       EL BLOQUEO SE APLICA AQUÍ, no solo en la pantalla. Filtrar en el
       cliente hace que no la veas —que ya es lo que pides—, pero no
       impide que ella te escriba, y eso es lo que de verdad hace falta
       cuando alguien te está molestando. La comprobación cuesta una
       lectura por comentario y los vale.

       Borrar lo puede hacer quien lo escribió Y la dueña del sitio
       donde está: por eso el comentario lleva dentro `targetOwner`, y
       por eso la regla exige al crearlo que ese campo no se lo invente
       quien comenta... salvo que sea suyo. Sin eso, cualquiera podría
       ponerse como dueña de los comentarios de otra.

       `update` no existe: un comentario editado después de que alguien
       lo haya leído —o reportado— es otra cosa distinta. Se borra y se
       escribe de nuevo. */
    match /comments/{target}/items/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.target == target
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 500
                    && !meBloqueo(request.resource.data.targetOwner);

      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || resource.data.targetOwner == request.auth.uid);

      allow update: if false;
    }

    /* Las reacciones de una publicación, todas en un documento
       {uid: emoji}. Cada quien solo puede tocar SU entrada: la regla
       comprueba que lo que cambia sea únicamente la clave con tu uid.
       Sin eso, cualquiera podría borrar las reacciones de los demás. */
    match /reactions/{target} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.de.diff(
                        resource == null ? {} : resource.data.de
                      ).affectedKeys().hasOnly([request.auth.uid]);
    }

    /* ── REPORTES  ·  historia #51 ────────────────────────────
       SE ESCRIBEN Y NO SE LEEN. Si se pudieran leer desde la app,
       cualquiera podría enterarse de quién ha reportado a quién, que es
       la forma más rápida de que reportar deje de usarse. La cola de
       revisión se mira desde la consola de Firebase, fuera de la app.

       Tampoco se pueden borrar ni editar: un reporte que quien acosa
       puede hacer desaparecer no sirve de nada. */
    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.de == request.auth.uid
                    && request.resource.data.estado == 'pendiente';
      allow update, delete: if false;
    }

    /* La colección `biblioteca` era de la época sin autenticación.
       Estuvo abierta a cualquier cuenta con sesión para poder migrarla
       una vez — lo que significaba que CUALQUIER usuaria podía leer y
       borrar esa biblioteca. Eso fue un error: la migración ya ocurrió,
       así que la puerta se cierra del todo.

       Si alguna vez hiciera falta reabrirla, hay que acotarla al dueño,
       nunca a "cualquiera con sesión". */

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
